# ============================================
# Environment Configuration Template
# ============================================
# Copy this file to .env and fill in the values

# ============================================
# Node Environment
# ============================================
NODE_ENV=development

# ============================================
# Server Configuration
# ============================================
PORT=4000

# ============================================
# Database Configuration
# ============================================
# SQLite database file path
DATABASE_URL="file:./data/projecty.db"

# ============================================
# Blockchain Configuration
# ============================================
# Local development: http://127.0.0.1:8545
# Testnet (Sepolia): https://sepolia.infura.io/v3/YOUR_INFURA_KEY
# Mainnet: https://mainnet.infura.io/v3/YOUR_INFURA_KEY
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545

# Private key for backend transactions (NEVER commit real keys!)
# For local dev, use Hardhat account #0:
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# ============================================
# IPFS / Pinata Configuration
# ============================================
# Get your JWT from https://pinata.cloud/
PINATA_JWT=your_pinata_jwt_token_here

# ============================================
# Event Listener Configuration
# ============================================
# Poll blockchain every 5 seconds
EVENT_POLL_INTERVAL_MS=5000

# Start syncing from latest block or specific block number
EVENT_START_BLOCK=latest

# ============================================
# Reconciler Configuration
# ============================================
# Enable automatic fixes for safe mismatches
RECONCILER_AUTO_FIX=true

# Run reconciliation every 60 seconds
RECONCILE_INTERVAL_MS=60000

# Maximum records to process per reconciliation run
RECONCILER_MAX_BATCH_SIZE=100

# ============================================
# Transaction Safety Configuration
# ============================================
# Wait up to 2 minutes for transaction confirmation
TX_WAIT_TIMEOUT_MS=120000

# Maximum gas price willing to pay (in gwei)
# Leave empty for automatic estimation
MAX_GAS_PRICE=

# ============================================
# Security Configuration
# ============================================
# CORS allowed origins (comma-separated)
# For production, specify your frontend domain
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# JWT secret for API authentication (if implementing auth)
# JWT_SECRET=your_random_secret_key_here

# ============================================
# Logging Configuration
# ============================================
# Log level: error, warn, info, debug
LOG_LEVEL=info

# Enable structured JSON logging
LOG_FORMAT=json

# ============================================
# Production-Specific Settings
# ============================================
# (Uncomment for production deployment)

# NODE_ENV=production

# Use persistent PostgreSQL instead of SQLite
# DATABASE_URL=postgresql://user:password@host:5432/projecty

# Connect to mainnet or testnet
# BLOCKCHAIN_RPC_URL=https://mainnet.infura.io/v3/YOUR_KEY

# Disable auto-fix in production (manual review recommended)
# RECONCILER_AUTO_FIX=false

# Increase reconciliation interval for production
# RECONCILE_INTERVAL_MS=300000

# ============================================
# Optional Features
# ============================================
# Enable if using Web3 provider
# WEB3_PROVIDER_URL=

# Enable if using external monitoring
# SENTRY_DSN=

# Enable if using external logging service
# DATADOG_API_KEY=

# ============================================
# Development-Only Settings
# ============================================
# Auto-reload on file changes
DEV_AUTO_RELOAD=true

# Show detailed error messages
DEV_SHOW_STACK_TRACE=true
